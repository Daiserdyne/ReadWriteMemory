<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Platforms>x64</Platforms>
		<OutputType>Library</OutputType>
		<WindowsPackageType>None</WindowsPackageType>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<RootNamespace>ReadWriteMemory.External</RootNamespace>
		<IncludeBuildOutput>true</IncludeBuildOutput>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.2.1</Version>
		<Authors>Daiserdyne</Authors>
		<Product>ReadWriteMemoryExternal</Product>
		<Description>A powerfull memory editing library.</Description>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageIcon>Assets\icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Assets\icon.png" Pack="true" PackagePath="\Assets"/>
	</ItemGroup>
</Project>